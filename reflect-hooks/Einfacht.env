# Einfacht.env —— 本仓事实系统配置（由 reflect-hooks/einfacht-env.sh 自动加载）
#
# 为什么有这个文件：git 不把自定义环境变量传给钩子，只在 shell 里 export 的
# REFLECT_* 钩子看不见；文件才是钩子可复现的来源。没有本文件 ⇒ 全部旋钮回落默认名。

export REFLECT_FACTS="FACTS.json"
export REFLECT_DOC="STATE.md"
export REFLECT_DOCS="STATE.md,README.md,maintaince.md"

export REFLECT_QUESTIONS="questions"
export REFLECT_RETRACTIONS="retractions.json"
# 不变量闸门**不启用**（与上游 Einfacht 一致）：knob 空 = 明说未启用。
#
# 为什么不用：启用它会让 gates-selftest 的「换名自证」失败 —— 夹具仓库里没有
# 这个名字的文件，闸门在夹具里 fatal，而自证要求「换名后全绿」。
# 上游自己也没启用（它仓里根本没有 invariants.json）。
# 本仓的同类保护已由别处覆盖：插件索引表由 README 人工维护，
# 数据层必须从 ledger 借 fact() 这一条写在 gates 自证里。
export REFLECT_INVARIANTS=""

# 本仓只有单语 README（英文）⇒ 三语判据按名单收窄为一份。
export REFLECT_READMES="README.md"

# 采集模块：本仓要量的是插件生态（插件数/测试覆盖/缺口），不是上游那个数 py/md 的占位实现。
export REFLECT_MEASURE_MODULE="measure_plugins"
