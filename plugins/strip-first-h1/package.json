{
  "name": "@shirone-plugins/strip-first-h1",
  "version": "0.1.0",
  "description": "Zero-runtime, AST-level remark plugin and Astro integration to strip redundant first H1 headings from markdown posts in Shirone",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "shirone",
    "shirone-plugin",
    "astro",
    "astro-integration",
    "remark",
    "remark-plugin",
    "heading",
    "h1"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && node --test tests/**/*.test.mjs"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
