{
	"name": "@shirone-plugins/steam-recent",
	"version": "0.1.0",
	"description": "Build-time Steam recently-played section for the Shirone games page: a versioned JSON snapshot fetched by a CI script, rendered as pure SSR markup with zero client JavaScript",
	"license": "MIT",
	"author": "ArchivalEra",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./section/*": "./src/section/*",
		"./cli/*": "./src/cli/*",
		"./package.json": "./package.json"
	},
	"keywords": [
		"shirone",
		"shirone-plugin",
		"steam",
		"recently-played",
		"games",
		"build-time-snapshot",
		"m3e"
	],
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"test": "pnpm run build && node --test tests/"
	},
	"peerDependencies": {
		"astro": ">=5.0.0",
		"svelte": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"dependencies": {},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"typescript": "^5.8.0"
	},
	"engines": {
		"node": ">=20"
	}
}
