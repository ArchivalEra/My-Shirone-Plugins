#!/usr/bin/env bash
#
# Git pre-push hook: Enforces that `maintaince.md` is updated in every push.
#
set -euo pipefail

remote="$1"
url="$2"

z40="0000000000000000000000000000000000000000"
has_error=0

while read -r local_ref local_oid remote_ref remote_oid; do
    # 1. Ignore ref deletion (e.g. git push origin --delete branch)
    if [ "$local_oid" = "$z40" ]; then
        continue
    fi

    # 2. Ignore no-op pushes (local ref already equals remote ref, up-to-date)
    if [ "$local_oid" = "$remote_oid" ]; then
        continue
    fi

    # 3. Ignore tag or notes pushes (releases/annotations do not require code maintenance logs)
    if [[ "$local_ref" == refs/tags/* ]] || [[ "$remote_ref" == refs/tags/* ]] || \
       [[ "$local_ref" == refs/notes/* ]] || [[ "$remote_ref" == refs/notes/* ]]; then
        continue
    fi

    updated=0

    # 4. Check commit range
    if [ "$remote_oid" = "$z40" ]; then
        # New branch being pushed.
        # Find merge-base with candidate tracking branches
        base=""
        candidates=(
            "refs/remotes/$remote/main"
            "refs/remotes/$remote/master"
            "refs/remotes/$remote/HEAD"
            "refs/remotes/origin/main"
            "refs/remotes/origin/master"
            "refs/remotes/upstream/main"
            "refs/heads/main"
            "refs/heads/master"
        )
        for candidate in "${candidates[@]}"; do
            if git rev-parse --verify "$candidate" >/dev/null 2>&1; then
                base=$(git merge-base "$local_oid" "$candidate" 2>/dev/null || true)
                if [ -n "$base" ]; then
                    break
                fi
            fi
        done

        if [ -n "$base" ]; then
            if [ "$base" = "$local_oid" ]; then
                # Branch has no new commits compared to base
                updated=1
            elif git diff --name-only "$base" "$local_oid" -- maintaince.md | grep -qx "maintaince.md"; then
                updated=1
            fi
        else
            # No base ref found. Check commits introduced by local_oid not present in any remote tracking ref
            new_commits=$(git rev-list "$local_oid" --not --remotes 2>/dev/null || true)
            if [ -z "$new_commits" ]; then
                # If all commits are already reachable via some remote, nothing truly new is introduced
                updated=1
            else
                if [ -n "$(git rev-list "$local_oid" --not --remotes -n 1 -- maintaince.md 2>/dev/null || true)" ]; then
                    updated=1
                fi
                # Fallback for initial push of a repo with no remotes: check if maintaince.md exists at all in local_oid
                if [ "$updated" -eq 0 ] && git ls-tree "$local_oid" -- maintaince.md 2>/dev/null | grep -q "maintaince.md"; then
                    if [ -z "$(git rev-list --remotes -n 1 2>/dev/null || true)" ]; then
                        updated=1
                    fi
                fi
            fi
        fi
    else
        # Existing branch update: git diff between remote_oid and local_oid
        if git cat-file -e "$remote_oid" 2>/dev/null; then
            if git diff --name-only "$remote_oid" "$local_oid" -- maintaince.md | grep -qx "maintaince.md"; then
                updated=1
            fi
        else
            # remote_oid not available locally (e.g. shallow clone or fetched by other ref)
            # fallback to checking commits between remote tracking branch and local_oid
            remote_branch="${remote_ref#refs/heads/}"
            tracking_ref="refs/remotes/$remote/$remote_branch"
            if git rev-parse --verify "$tracking_ref" >/dev/null 2>&1; then
                if git diff --name-only "$tracking_ref" "$local_oid" -- maintaince.md | grep -qx "maintaince.md"; then
                    updated=1
                fi
            else
                # If cannot determine, check if local_oid touched maintaince.md in latest commit
                if git diff-tree --no-commit-id --name-only -r "$local_oid" -- maintaince.md | grep -qx "maintaince.md"; then
                    updated=1
                fi
            fi
        fi
    fi

    if [ "$updated" -eq 0 ]; then
        echo "" >&2
        echo "================================================================================" >&2
        echo " [PRE-PUSH REJECTED] 推送被拦截：maintaince.md 未更新！" >&2
        echo "================================================================================" >&2
        echo " 仓库规范要求：每次向远端推送代码或内容时，必须更新 maintaince.md 说明本次做了什么。" >&2
        echo " 目标推送引用: $local_ref -> $remote_ref ($remote)" >&2
        echo "" >&2
        # Check uncommitted status in working tree / staged
        if [ -n "$(git status --porcelain maintaince.md 2>/dev/null)" ]; then
            echo " [提示] 检测到本地工作区存在尚未提交至 Git 的 maintaince.md 改动！" >&2
            echo " 请先将 maintaince.md 提交到 Git 中，再执行推送：" >&2
            echo "   git add maintaince.md" >&2
            echo "   git commit --amend           # 追加到前一个提交" >&2
            echo "   或者: git commit -m 'docs: update maintaince.md'" >&2
        else
            echo " [操作步骤]:" >&2
            echo "   1. 编辑本仓库根目录下的 maintaince.md，在「维护与变更记录」中记录本次变更要点" >&2
            echo "   2. 暂存并提交变更：" >&2
            echo "        git add maintaince.md" >&2
            echo "        git commit --amend      # (推荐追加至前一次 commit)" >&2
            echo "        或 git commit -m 'docs: update maintaince.md'" >&2
            echo "   3. 重新推送 (凭据环境优先使用 gh cli):" >&2
            echo "        git push" >&2
        fi
        echo "================================================================================" >&2
        echo "" >&2
        has_error=1
    fi
done

if [ "$has_error" -ne 0 ]; then
    exit 1
fi

echo "✓ [pre-push] maintaince.md 变更校验通过，准予推送。"
exit 0
